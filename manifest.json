{
  "manifest_version": 3,
  "name": "YOPmail Checker",
  "version": "1.0.1",
  "description": "Quickly check your YOPmail inbox from the Chrome toolbar.",
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://yopmail.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
